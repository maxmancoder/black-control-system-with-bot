# محیط مجازی — هیچ‌وقت آپلود نمی‌شود
.venv/

# کش بایت‌کد پایتون
__pycache__/
*.pyc
*.pyo

# لاگ‌ها (مسیرهای داخلی و نام کاربر نباید منتشر شود)
logs/

# داده‌های محلی: کلیدهای API (secrets.json)، کش برنامه‌ها، قفل اجرا
# ⚠️ secrets.json کلید سرویس‌های AI را دارد؛ هرگز نباید در مخزن بیفتد.
data/

# خروجی‌های موقت ابزارها و تست
*.lock
*.tmp
